{
  "name": "syno-pkg-land-paperless-ngx",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "check": "synopkgland check --json",
    "build": "synopkgland build --arch x86_64 --json",
    "test": "python3 tests/bootstrap_test.py && node --test tests/*.test.mjs",
    "render": "node scripts/render.mjs",
    "e2e:nas": "node tests/e2e/nas.ts",
    "e2e:smoke": "node --env-file-if-exists=.env node_modules/@synopackageland/cli/dist/e2e/dsm.js tunnel -- e2e run tests/e2e/smoke.e2e.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@e2e-dev/web": "0.14.0",
    "@synopackageland/cli": "0.41.6",
    "@synopackageland/templates": "0.35.5",
    "ai": "7.0.137",
    "e2e": "0.19.0",
    "playwright": "1.63.0"
  }
}
